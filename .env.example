# KP Smart Crop Doctor - Environment Configuration Template
# Copy this file to .env and configure with your local or API settings

# Environment Mode: development / production / test
APP_ENV=development

# Device Configuration: 'auto', 'cuda', 'cpu'
DEVICE=auto

# RAG & LLM Provider Configuration
# Supported providers: 'huggingface', 'openai', 'groq', 'local'
LLM_PROVIDER=huggingface
HF_API_TOKEN=your_huggingface_token_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Vision Model Configuration
VISION_MODEL_BACKBONE=mobilenet_v3_large
NUM_CLASSES=38
TOP_K=2
CONFIDENCE_THRESHOLD=0.60

# Translation Engine
# Options: 'deep_translator', 'llm'
TRANSLATION_ENGINE=deep_translator
